<div id="welcomeContainer" style="display: none;">
    <div id="welcomeContent" class="rc-card rc-card--glow">
        <img id="welcomeImageSeal" src="assets/images/root-wordmark.png" alt="Root RP"/>
        <span class="rc-eyebrow">Crônica de chegada</span>
        <h1 id="welcomeHeader"><%- lang('welcome.welcomeHeader') %></h1>
        <p id="welcomeDescription"><%- lang('welcome.welcomeDescription') %></p>
        <ol class="rc-welcome-steps">
            <li><b>Passaporte</b><span>Entre com sua conta original ou um apelido.</span></li>
            <li><b>Preparação</b><span>Java, NeoForge e mods são instalados sozinhos.</span></li>
            <li><b>Selenia</b><span>Um clique em “Entrar em Selenia” e você está dentro.</span></li>
        </ol>
        <p id="welcomeDescCTA"><%- lang('welcome.welcomeDescCTA') %></p>
        <button id="welcomeButton" class="rc-btn-gold">
            <span id="welcomeButtonContent"><%- lang('welcome.continueButton') %> <span aria-hidden="true">→</span></span>
        </button>
    </div>
    <script src="./assets/js/scripts/welcome.js"></script>
</div>
