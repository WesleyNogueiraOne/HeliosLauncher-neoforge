<div id="settingsContainer" style="display: none;">

    <!-- ══════════ Cabeçalho da Oficina ══════════ -->
    <header id="settingsHeader">
        <div class="rc-oficina-title">
            <span class="rc-eyebrow" id="settingsNavHeaderText"><%- lang('settings.navHeaderText') %></span>
            <h1>Ajuste o motor antes da viagem.</h1>
        </div>
        <button id="settingsNavDone" class="rc-btn-ghost">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M20 11H7.8l5.6-5.6L12 4l-8 8 8 8 1.4-1.4L7.8 13H20v-2z"/></svg>
            <%- lang('settings.navDone') %>
        </button>
    </header>

    <!-- ══════════ Abas ══════════ -->
    <nav id="settingsNavItemsContent" class="rc-tabs" aria-label="Seções da Oficina">
        <button class="settingsNavItem rc-tab" rSc="settingsTabAccount" id="settingsNavAccount" selected><%- lang('settings.navAccount') %></button>
        <button class="settingsNavItem rc-tab" rSc="settingsTabMinecraft"><%- lang('settings.navMinecraft') %></button>
        <button class="settingsNavItem rc-tab" rSc="settingsTabJava"><%- lang('settings.navJava') %></button>
        <button class="settingsNavItem rc-tab" rSc="settingsTabMods"><%- lang('settings.navMods') %></button>
        <button class="settingsNavItem rc-tab" rSc="settingsTabLauncher"><%- lang('settings.navLauncher') %></button>
        <span class="settingsNavSpacer"></span>
        <button class="settingsNavItem rc-tab" rSc="settingsTabAbout"><%- lang('settings.navAbout') %></button>
        <button class="settingsNavItem rc-tab" rSc="settingsTabUpdate" id="settingsNavUpdate"><%- lang('settings.navUpdates') %></button>
    </nav>

    <div id="settingsContainerRight">

        <!-- ══════════ CONTAS ══════════ -->
        <div id="settingsTabAccount" class="settingsTab">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.tabAccountHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.tabAccountHeaderDesc') %></span>
            </div>
            <section class="settingsGroup rc-card settingsAuthAccountTypeContainer">
                <div class="settingsAuthAccountTypeHeader">
                    <div class="settingsAuthAccountTypeHeaderLeft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 23 23">
                            <path fill="#f35325" d="M1 1h10v10H1z" />
                            <path fill="#81bc06" d="M12 1h10v10H12z" />
                            <path fill="#05a6f0" d="M1 12h10v10H1z" />
                            <path fill="#ffba08" d="M12 12h10v10H12z" />
                        </svg>
                        <span><%- lang('settings.microsoftAccount') %></span>
                    </div>
                    <div class="settingsAuthAccountTypeHeaderRight">
                        <button class="settingsAddAuthAccount rc-btn-ghost rc-btn-sm" id="settingsAddMicrosoftAccount"><%- lang('settings.addMicrosoftAccount') %></button>
                    </div>
                </div>
                <div class="settingsCurrentAccounts" id="settingsCurrentMicrosoftAccounts">
                    <!-- Microsoft auth accounts populated here. -->
                </div>
            </section>

            <!-- Contas Mojang antigas: o settings.js ainda escreve aqui, a Mojang aposentou esse login. -->
            <div class="settingsCurrentAccounts" id="settingsCurrentMojangAccounts" hidden></div>

            <section class="settingsGroup rc-card settingsAuthAccountTypeContainer">
                <div class="settingsAuthAccountTypeHeader">
                    <div class="settingsAuthAccountTypeHeaderLeft">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
                        <span>Passaportes provisórios</span>
                    </div>
                    <div class="settingsAuthAccountTypeHeaderRight">
                        <button class="settingsAddAuthAccount rc-btn-ghost rc-btn-sm" id="settingsAddOfflineAccount">+ Adicionar passaporte</button>
                    </div>
                </div>
                <div id="settingsOfflineForm" class="settingsOfflineForm" hidden>
                    <input id="settingsOfflineName" class="rc-input" type="text" maxlength="16" spellcheck="false" autocomplete="off" placeholder="Apelido em Selenia (3 a 16 caracteres)">
                    <button id="settingsOfflineConfirm" class="rc-btn-gold rc-btn-sm">Carimbar passaporte</button>
                    <button id="settingsOfflineCancel" class="rc-link">Cancelar</button>
                    <span id="settingsOfflineMsg" class="settingsOfflineMsg"></span>
                </div>
                <div class="settingsCurrentAccounts" id="settingsCurrentOfflineAccounts">
                    <!-- Offline auth accounts populated here. -->
                </div>
            </section>
        </div>

        <!-- ══════════ JOGO ══════════ -->
        <div id="settingsTabMinecraft" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.minecraftTabHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.minecraftTabHeaderDesc') %></span>
            </div>
            <section class="settingsGroup rc-card" id="settingsGameResolutionContainer">
                <div class="settingsGroupTitle"><span class="rc-eyebrow">Janela</span></div>
                <div class="settingsFieldContainer">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.gameResolutionTitle') %></span>
                        <span class="settingsFieldDesc">Largura × altura da janela do jogo, em pixels.</span>
                    </div>
                    <div class="settingsFieldRight" id="settingsGameResolutionContent">
                        <input type="number" id="settingsGameWidth" min="0" cValue="GameWidth">
                        <div id="settingsGameResolutionCross">×</div>
                        <input type="number" id="settingsGameHeight" min="0" cValue="GameHeight">
                    </div>
                </div>
                <div class="settingsFieldContainer">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.launchFullscreenTitle') %></span>
                    </div>
                    <div class="settingsFieldRight">
                        <label class="toggleSwitch">
                            <input type="checkbox" cValue="Fullscreen">
                            <span class="toggleSwitchSlider"></span>
                        </label>
                    </div>
                </div>
            </section>
            <section class="settingsGroup rc-card">
                <div class="settingsGroupTitle"><span class="rc-eyebrow">Ao iniciar</span></div>
                <div class="settingsFieldContainer">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.autoConnectTitle') %></span>
                    </div>
                    <div class="settingsFieldRight">
                        <label class="toggleSwitch">
                            <input type="checkbox" cValue="AutoConnect">
                            <span class="toggleSwitchSlider"></span>
                        </label>
                    </div>
                </div>
                <div class="settingsFieldContainer">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.launchDetachedTitle') %></span>
                        <span class="settingsFieldDesc"><%- lang('settings.launchDetachedDesc') %></span>
                    </div>
                    <div class="settingsFieldRight">
                        <label class="toggleSwitch">
                            <input type="checkbox" cValue="LaunchDetached">
                            <span class="toggleSwitchSlider"></span>
                        </label>
                    </div>
                </div>
            </section>
        </div>

        <!-- ══════════ MODS ══════════ -->
        <div id="settingsTabMods" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.tabModsHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.tabModsHeaderDesc') %></span>
            </div>
            <section class="settingsGroup rc-card settingsSelServContainer">
                <div class="settingsSelServContent"></div>
                <div class="settingsSwitchServerContainer">
                    <div class="settingsSwitchServerContent">
                        <button class="settingsSwitchServerButton rc-btn-ghost rc-btn-sm"><%- lang('settings.switchServerButton') %></button>
                    </div>
                </div>
            </section>
            <div id="settingsModsContainer">
                <section class="settingsGroup rc-card" id="settingsOptModsContainer">
                    <div class="settingsModsHeader"><span class="rc-eyebrow"><%- lang('settings.optionalMods') %></span></div>
                    <div id="settingsOptModsContent"></div>
                </section>
                <section class="settingsGroup rc-card" id="settingsDropinModsContainer">
                    <div class="settingsModsHeader">
                        <span class="rc-eyebrow"><%- lang('settings.dropinMods') %></span>
                        <button id="settingsDropinFileSystemButton" class="rc-btn-ghost rc-btn-sm"><%- lang('settings.addMods') %> <span id="settingsDropinRefreshNote"><%- lang('settings.dropinRefreshNote') %></span></button>
                    </div>
                    <div id="settingsDropinModsContent"></div>
                </section>
                <section class="settingsGroup rc-card" id="settingsShadersContainer">
                    <div class="settingsModsHeader"><span class="rc-eyebrow"><%- lang('settings.shaderpacks') %></span></div>
                    <div id="settingsShaderpackDesc"><%- lang('settings.shaderpackDesc') %></div>
                    <div id="settingsShaderpackWrapper">
                        <button id="settingsShaderpackButton" class="rc-icon-btn" data-tip="Adicionar shaderpack">+</button>
                        <div class="settingsSelectContainer">
                            <div class="settingsSelectSelected" id="settingsShadersSelected"><%- lang('settings.selectShaderpack') %></div>
                            <div class="settingsSelectOptions" id="settingsShadersOptions" hidden></div>
                        </div>
                    </div>
                </section>
                <section class="settingsGroup rc-card" id="settingsReqModsContainer">
                    <div class="settingsModsHeader">
                        <span class="rc-eyebrow"><%- lang('settings.requiredMods') %></span>
                        <span class="settingsModsHint">Sincronizados pelo modpack oficial</span>
                    </div>
                    <div id="settingsReqModsContent"></div>
                </section>
            </div>
        </div>

        <!-- ══════════ DESEMPENHO (Java) ══════════ -->
        <div id="settingsTabJava" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.tabJavaHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.tabJavaHeaderDesc') %></span>
            </div>
            <div class="settingsSelServContainer" hidden>
                <div class="settingsSelServContent"></div>
                <div class="settingsSwitchServerContainer"><div class="settingsSwitchServerContent">
                    <button class="settingsSwitchServerButton rc-btn-ghost rc-btn-sm"><%- lang('settings.switchServerButton') %></button>
                </div></div>
            </div>
            <div class="settingsColumns">
                <section class="settingsGroup rc-card" id="settingsMemoryContainer">
                    <div class="settingsGroupTitle"><span class="rc-eyebrow" id="settingsMemoryTitle"><%- lang('settings.memoryTitle') %></span></div>
                    <div id="settingsMemoryContent">
                        <div id="settingsMemoryContentLeft">
                            <div class="settingsMemoryContentItem">
                                <span class="settingsMemoryHeader"><%- lang('settings.maxRAM') %></span>
                                <div class="settingsMemoryActionContainer">
                                    <div id="settingsMaxRAMRange" class="rangeSlider" cValue="MaxRAM" serverDependent min="3" max="8" value="3" step="0.5">
                                        <div class="rangeSliderBar"></div>
                                        <div class="rangeSliderTrack"></div>
                                    </div>
                                    <span id="settingsMaxRAMLabel" class="settingsMemoryLabel">3G</span>
                                </div>
                            </div>
                            <div class="settingsMemoryContentItem">
                                <span class="settingsMemoryHeader"><%- lang('settings.minRAM') %></span>
                                <div class="settingsMemoryActionContainer">
                                    <div id="settingsMinRAMRange" class="rangeSlider" cValue="MinRAM" serverDependent min="3" max="8" value="3" step="0.5">
                                        <div class="rangeSliderBar"></div>
                                        <div class="rangeSliderTrack"></div>
                                    </div>
                                    <span id="settingsMinRAMLabel" class="settingsMemoryLabel">3G</span>
                                </div>
                            </div>
                            <div id="settingsMemoryDesc"><%- lang('settings.memoryDesc') %></div>
                        </div>
                    </div>
                </section>
                <section class="settingsGroup rc-card" id="settingsMemoryContentRight">
                    <div class="settingsGroupTitle"><span class="rc-eyebrow">Seu computador</span></div>
                    <div id="settingsMemoryStatus">
                        <div class="settingsMemoryStatusContainer">
                            <span class="settingsMemoryStatusTitle"><%- lang('settings.memoryTotalTitle') %></span>
                            <span id="settingsMemoryTotal" class="settingsMemoryStatusValue">16G</span>
                        </div>
                        <div class="settingsMemoryStatusContainer">
                            <span class="settingsMemoryStatusTitle"><%- lang('settings.memoryAvailableTitle') %></span>
                            <span id="settingsMemoryAvail" class="settingsMemoryStatusValue">7.3G</span>
                        </div>
                    </div>
                    <p class="settingsFieldDesc">Deixe pelo menos 2 GB livres para o sistema. O modpack roda bem entre 6 e 8 GB.</p>
                </section>
            </div>
            <section class="settingsGroup rc-card settingsFileSelContainer">
                <div class="settingsGroupTitle"><span class="rc-eyebrow settingsFileSelTitle"><%- lang('settings.javaExecutableTitle') %></span></div>
                <div class="settingsFileSelContent">
                    <div id="settingsJavaExecDetails"></div>
                    <div class="settingsFileSelActions">
                        <input class="settingsFileSelVal" id="settingsJavaExecVal" type="text" value="null" cValue="JavaExecutable" serverDependent disabled>
                        <button class="settingsFileSelButton rc-btn-ghost rc-btn-sm" id="settingsJavaExecSel" dialogTitle="<%- lang('settings.javaExecSelDialogTitle') %>" dialogDirectory="false"><%- lang('settings.javaExecSelButtonText') %></button>
                    </div>
                </div>
                <div class="settingsFileSelDesc"><%- lang('settings.javaExecDesc') %> <strong id="settingsJavaReqDesc"></strong><br><%- lang('settings.javaPathDesc', {'pathSuffix': `bin${process.platform === 'win32' ? '\\javaw.exe' : '/java'}`}) %></div>
            </section>
            <section class="settingsGroup rc-card" id="settingsJVMOptsContainer">
                <div class="settingsGroupTitle"><span class="rc-eyebrow" id="settingsJVMOptsTitle"><%- lang('settings.jvmOptsTitle') %></span></div>
                <div id="settingsJVMOptsContent">
                    <input id="settingsJVMOptsVal" cValue="JVMOptions" serverDependent type="text" spellcheck="false">
                </div>
                <div id="settingsJVMOptsDesc"><%- lang('settings.jvmOptsDesc') %><br><a href="#" id="settingsJvmOptsLink"></a></div>
            </section>
        </div>

        <!-- ══════════ LAUNCHER ══════════ -->
        <div id="settingsTabLauncher" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.launcherTabHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.launcherTabHeaderDesc') %></span>
            </div>
            <section class="settingsGroup rc-card">
                <div class="settingsFieldContainer">
                    <div class="settingsFieldLeft">
                        <span class="settingsFieldTitle"><%- lang('settings.allowPrereleaseTitle') %></span>
                        <span class="settingsFieldDesc"><%- lang('settings.allowPrereleaseDesc') %></span>
                    </div>
                    <div class="settingsFieldRight">
                        <label class="toggleSwitch">
                            <input type="checkbox" cValue="AllowPrerelease">
                            <span class="toggleSwitchSlider"></span>
                        </label>
                    </div>
                </div>
            </section>
            <section class="settingsGroup rc-card settingsFileSelContainer">
                <div class="settingsGroupTitle"><span class="rc-eyebrow" id="settingsDataDirTitle"><%- lang('settings.dataDirectoryTitle') %></span></div>
                <div class="settingsFileSelContent">
                    <div class="settingsFileSelActions">
                        <input class="settingsFileSelVal" type="text" value="null" cValue="DataDirectory" disabled>
                        <button class="settingsFileSelButton rc-btn-ghost rc-btn-sm" dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true"><%- lang('settings.chooseFolder') %></button>
                    </div>
                </div>
                <div class="settingsFileSelDesc"><%- lang('settings.dataDirectoryDesc') %></div>
            </section>
        </div>

        <!-- ══════════ SOBRE ══════════ -->
        <div id="settingsTabAbout" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.aboutTabHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.aboutTabHeaderDesc') %></span>
            </div>
            <section class="settingsGroup rc-card rc-card--glow" id="settingsAboutCurrentContainer">
                <div id="settingsAboutCurrentContent">
                    <div id="settingsAboutCurrentHeadline">
                        <img id="settingsAboutLogo" src="./assets/images/logo.png" alt="">
                        <div>
                            <span id="settingsAboutTitle"><%- lang('settings.aboutTitle', { appName: lang('app.title') }) %></span>
                            <div id="settingsAboutCurrentVersion">
                                <div id="settingsAboutCurrentVersionCheck">&#10003;</div>
                                <div id="settingsAboutCurrentVersionDetails">
                                    <span id="settingsAboutCurrentVersionTitle"><%- lang('settings.stableRelease') %></span>
                                    <div id="settingsAboutCurrentVersionLine">
                                        <span id="settingsAboutCurrentVersionText"><%- lang('settings.versionText') %></span>
                                        <span id="settingsAboutCurrentVersionValue">—</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="settingsAboutButtons">
                        <a href="<%- lang('settings.supportLink') %>" id="settingsAboutSupportButton" class="settingsAboutButton rc-btn-ghost rc-btn-sm"><%- lang('settings.support') %></a>
                        <a href="#" id="settingsAboutDevToolsButton" class="settingsAboutButton rc-btn-ghost rc-btn-sm"><%- lang('settings.devToolsConsole') %></a>
                    </div>
                </div>
            </section>
            <section class="settingsGroup rc-card settingsChangelogContainer">
                <div class="settingsChangelogContent">
                    <div class="settingsChangelogHeadline">
                        <div class="settingsChangelogLabel rc-eyebrow"><%- lang('settings.releaseNotes') %></div>
                        <div class="settingsChangelogTitle"><%- lang('settings.changelog') %></div>
                    </div>
                    <div class="settingsChangelogText"><%- lang('settings.noReleaseNotes') %></div>
                </div>
                <div class="settingsChangelogActions">
                    <a class="settingsChangelogButton settingsAboutButton rc-link" href="#"><%- lang('settings.viewReleaseNotes') %></a>
                </div>
            </section>
        </div>

        <!-- ══════════ ATUALIZAÇÕES ══════════ -->
        <div id="settingsTabUpdate" class="settingsTab" style="display: none;">
            <div class="settingsTabHeader">
                <span class="settingsTabHeaderText"><%- lang('settings.launcherUpdatesHeaderText') %></span>
                <span class="settingsTabHeaderDesc"><%- lang('settings.launcherUpdatesHeaderDesc') %></span>
            </div>
            <section class="settingsGroup rc-card rc-card--glow" id="settingsUpdateStatusContainer">
                <div id="settingsUpdateStatusContent">
                    <div>
                        <div id="settingsUpdateStatusHeadline">
                            <span id="settingsUpdateTitle"></span>
                        </div>
                        <div id="settingsUpdateVersion">
                            <div id="settingsUpdateVersionCheck">&#10003;</div>
                            <div id="settingsUpdateVersionDetails">
                                <span id="settingsUpdateVersionTitle"><%- lang('settings.stableRelease') %></span>
                                <div id="settingsUpdateVersionLine">
                                    <span id="settingsUpdateVersionText"><%- lang('settings.versionText') %> </span>
                                    <span id="settingsUpdateVersionValue">—</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="settingsUpdateActionContainer">
                        <button id="settingsUpdateActionButton" class="rc-btn-gold"><%- lang('settings.checkForUpdates') %></button>
                    </div>
                </div>
            </section>
            <section class="settingsGroup rc-card settingsChangelogContainer">
                <div class="settingsChangelogContent">
                    <div class="settingsChangelogHeadline">
                        <div class="settingsChangelogLabel rc-eyebrow"><%- lang('settings.whatsNew') %></div>
                        <div class="settingsChangelogTitle"><%- lang('settings.updateReleaseNotes') %></div>
                    </div>
                    <div class="settingsChangelogText"><%- lang('settings.noReleaseNotes') %></div>
                </div>
            </section>
        </div>
    </div>
    <script src="./assets/js/scripts/settings.js"></script>
</div>
