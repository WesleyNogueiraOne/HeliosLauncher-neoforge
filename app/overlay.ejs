<div id="overlayContainer" style="display: none;">
    <div id="serverSelectContent" class="rc-modal rc-card rc-card--glow" style="display: none;">
        <span class="rc-eyebrow">Destino</span>
        <span id="serverSelectHeader"><%- lang('overlay.serverSelectHeader') %></span>
        <div id="serverSelectList">
            <div id="serverSelectListScrollable">
                <!-- Server listings populated here. -->
            </div>
        </div>
        <div id="serverSelectActions" class="rc-modal-actions">
            <div id="serverSelectCancelWrapper">
                <button id="serverSelectCancel" class="overlayKeybindEsc rc-btn-ghost"><%- lang('overlay.serverSelectCancel') %></button>
            </div>
            <button id="serverSelectConfirm" class="overlayKeybindEnter rc-btn-gold" type="submit"><%- lang('overlay.serverSelectConfirm') %></button>
        </div>
    </div>
    <div id="accountSelectContent" class="rc-modal rc-card rc-card--glow" style="display: none;">
        <span class="rc-eyebrow">Passaportes</span>
        <span id="accountSelectHeader"><%- lang('overlay.accountSelectHeader') %></span>
        <div id="accountSelectList">
            <div id="accountSelectListScrollable">
                <!-- Accounts populated here. -->
            </div>
        </div>
        <div id="accountSelectActions" class="rc-modal-actions">
            <div id="accountSelectCancelWrapper">
                <button id="accountSelectCancel" class="overlayKeybindEsc rc-btn-ghost"><%- lang('overlay.accountSelectCancel') %></button>
            </div>
            <button id="accountSelectConfirm" class="overlayKeybindEnter rc-btn-gold" type="submit"><%- lang('overlay.accountSelectConfirm') %></button>
        </div>
    </div>
    <div id="overlayContent" class="rc-modal rc-card rc-card--glow">
        <span class="rc-eyebrow">Aviso</span>
        <span id="overlayTitle">&nbsp;</span>
        <span id="overlayDesc">&nbsp;</span>
        <div id="overlayActionContainer" class="rc-modal-actions">
            <div id="overlayDismissWrapper">
                <button id="overlayDismiss" style="display: none;" class="overlayKeybindEsc rc-btn-ghost">Fechar</button>
            </div>
            <button id="overlayAcknowledge" class="overlayKeybindEnter rc-btn-gold">OK</button>
        </div>
    </div>
    <script src="./assets/js/scripts/overlay.js"></script>
</div>
