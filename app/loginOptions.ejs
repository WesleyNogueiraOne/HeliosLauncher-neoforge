<div id="loginOptionsContainer" style="display: none;">
    <div id="loginOptionsContent">

        <!-- Lado da arte: reinos de Selenia em rotação -->
        <div class="rc-login-art">
            <div class="rc-login-art-shade"></div>
            <div id="rcKingdom" class="rc-kingdom">
                <span class="rc-eyebrow">Os sete reinos</span>
                <h2 class="rc-kingdom-name">Selenia</h2>
                <p class="rc-kingdom-epithet"></p>
                <p class="rc-kingdom-root"></p>
            </div>
            <div id="rcKingdomDots" class="rc-kingdom-dots"></div>
            <blockquote class="rc-login-quote">“Toda raiz sustenta o mundo.”<cite>— Crônicas de Selenia</cite></blockquote>
        </div>

        <!-- Lado do passaporte -->
        <div class="loginOptionsMainContent rc-passport">
            <img class="rcLoginLogo" src="assets/images/logo.png" alt="">
            <span class="rc-eyebrow">Passaporte de Selenia</span>
            <h2 class="rc-passport-title">Antes de cruzar a fronteira, diga quem você é.</h2>

            <div class="loginOptionActions">
                <div class="loginOptionButtonContainer">
                    <button id="loginOptionMicrosoft" class="loginOptionButton rc-passport-option is-primary">
                        <span class="rc-passport-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 23 23">
                                <path fill="#f35325" d="M1 1h10v10H1z" />
                                <path fill="#81bc06" d="M12 1h10v10H12z" />
                                <path fill="#05a6f0" d="M1 12h10v10H1z" />
                                <path fill="#ffba08" d="M12 12h10v10H12z" />
                            </svg>
                        </span>
                        <span class="rc-passport-label">
                            <b><%- lang('loginOptions.loginWithMicrosoft') %></b>
                            <small>Conta original · skin oficial</small>
                        </span>
                        <span class="rc-passport-arrow">→</span>
                    </button>
                </div>
                <div class="loginOptionButtonContainer">
                    <button id="loginOptionOffline" class="loginOptionButton rc-passport-option">
                        <span class="rc-passport-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
                                <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
                            </svg>
                        </span>
                        <span class="rc-passport-label">
                            <b><%- lang('loginOptions.loginWithOffline') %></b>
                            <small>Escolha um apelido de 3 a 16 caracteres</small>
                        </span>
                        <span class="rc-passport-arrow">→</span>
                    </button>
                </div>
            </div>

            <!-- Passaporte provisório (offline) -->
            <div id="offlineLoginForm" style="display: none;">
                <label class="rc-field-label" for="offlineUsernameInput">Como devemos te chamar?</label>
                <input id="offlineUsernameInput" class="rcInput rc-input" type="text" placeholder="<%- lang('loginOptions.offlineUsernamePlaceholder') %>" maxlength="16" spellcheck="false" autocomplete="off"/>
                <p class="rcHint">3 a 16 caracteres: letras, números e _</p>
                <div class="rc-passport-actions">
                    <button id="offlineLoginBack" class="rcBtnGhost rc-btn-ghost">← <%- lang('loginOptions.offlineBackButton') %></button>
                    <button id="offlineLoginConfirm" class="rcBtnPrimary rc-btn-gold"><%- lang('loginOptions.offlineConfirmButton') %></button>
                </div>
            </div>

            <div class="rc-passport-foot">
                <span>Novo por aqui?</span>
                <a href="<%= lang('landing.shortcutSiteURL') %>/como-jogar">Como jogar ↗</a>
                <% const loginDiscord_ = lang('landing.mediaDiscordURL') %><% if (loginDiscord_ && loginDiscord_ !== '#') { %><a href="<%= loginDiscord_ %>">Discord ↗</a><% } %>
            </div>
            <div class="rc-passport-legal">16+ · Sem pay-to-win · <a href="<%= lang('landing.shortcutSiteURL') %>/termos">Termos ↗</a></div>

            <div id="loginOptionCancelContainer" style="display: none;">
                <button id="loginOptionCancelButton" class="rc-link">← <%- lang('loginOptions.cancelButton') %></button>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
