<div id="frameBar">
    <div id="frameResizableTop" class="frameDragPadder"></div>
    <div id="frameMain">
        <div class="frameResizableVert frameDragPadder"></div>
        <%if (process.platform === 'darwin') { %>
            <div id="frameContentDarwin">
                <div id="frameButtonDockDarwin">
                    <button class="frameButtonDarwin fCb" id="frameButtonDarwin_close" tabIndex="-1" aria-label="Fechar"></button>
                    <button class="frameButtonDarwin fMb" id="frameButtonDarwin_minimize" tabIndex="-1" aria-label="Minimizar"></button>
                    <button class="frameButtonDarwin fRb" id="frameButtonDarwin_restoredown" tabIndex="-1" aria-label="Maximizar"></button>
                </div>
                <div id="frameTitleDock">
                    <img id="frameTitleLogo" src="assets/images/logo.png" alt="">
                    <span id="frameTitleText">Root <b>Client</b></span>
                    <span id="frameTitleSep"></span>
                    <span id="frameTitleSub">Continente de Selenia</span>
                </div>
                <div></div>
            </div>
        <% } else{ %>
            <div id="frameContentWin">
                <div id="frameTitleDock">
                    <img id="frameTitleLogo" src="assets/images/logo.png" alt="">
                    <span id="frameTitleText">Root <b>Client</b></span>
                    <span id="frameTitleSep"></span>
                    <span id="frameTitleSub">Continente de Selenia</span>
                </div>
                <div id="frameButtonDockWin">
                    <button class="frameButton fMb" id="frameButton_minimize" tabIndex="-1" aria-label="Minimizar">
                        <svg viewBox="0 0 12 12"><rect fill="#ffffff" width="10" height="1.2" x="1" y="6"></rect></svg>
                    </button>
                    <button class="frameButton fRb" id="frameButton_restoredown" tabIndex="-1" aria-label="Maximizar">
                        <svg viewBox="0 0 12 12"><rect width="9" height="9" x="1.5" y="1.5" rx="1.5" fill="none" stroke="#ffffff" stroke-width="1.2"></rect></svg>
                    </button>
                    <button class="frameButton fCb" id="frameButton_close" tabIndex="-1" aria-label="Fechar">
                        <svg viewBox="0 0 12 12"><path d="M2 2 L10 10 M10 2 L2 10" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round"></path></svg>
                    </button>
                </div>
            </div>
        <% } %>
        <div class="frameResizableVert frameDragPadder"></div>
    </div>
</div>
