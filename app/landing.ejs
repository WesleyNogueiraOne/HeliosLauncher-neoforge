<div id="landingContainer" style="display: none;">
    <div id="rcDesk">

        <!-- ══════════ FICHA: quem eu sou + entrar no jogo ══════════ -->
        <aside id="rcFicha" class="rc-card rc-card--glow">
            <div class="rc-ficha-head">
                <span class="rc-eyebrow">Ficha do viajante</span>
                <div id="image_seal_container" class="rc-update-chip" data-tip="Ver atualização">
                    <span class="rc-update-dot"></span> Atualização
                    <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
                </div>
            </div>

            <div id="user_content" class="rc-portrait" title="Trocar de conta">
                <div class="rc-portrait-halo"></div>
                <div id="avatarContainer" class="rc-skin"></div>
                <div class="rc-portrait-floor"></div>
                <button id="avatarOverlay" class="rc-portrait-manage"><%- lang('landing.usernameEditButton') %></button>
            </div>

            <div class="rc-ficha-id">
                <h2 id="user_text_main"><%- lang('landing.usernamePlaceholder') %></h2>
                <span class="rc-account-tag"></span>
            </div>

            <dl class="rc-ficha-stats">
                <div><dt>Servidor</dt><dd id="rcFichaServer">—</dd></div>
                <div><dt>Versão</dt><dd id="rcFichaVersion">—</dd></div>
                <div><dt>Modpack</dt><dd id="rcFichaPack">—</dd></div>
                <div><dt>Site</dt><dd id="rcFichaLink">—</dd></div>
            </dl>

            <div class="rc-ficha-launch">
                <div id="launch_content" class="rc-launch-slot">
                    <button id="launch_button" class="rc-btn-gold rc-btn-play">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.2-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
                        <span><%- lang('landing.launchButton') %></span>
                    </button>
                </div>
                <div class="rc-play-busy"><span class="rc-spinner"></span> Preparando a viagem…</div>
                <div class="rc-in-game-note"><span class="status-dot online"></span> Em Selenia agora</div>
                <div class="rc-ficha-actions">
                    <button id="rcSwitchAccount" class="rc-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M7 7h11l-3-3 1.4-1.4L21.8 8l-5.4 5.4L15 12l3-3H7V7zm10 10H6l3 3-1.4 1.4L2.2 16l5.4-5.4L9 12l-3 3h11v2z"/></svg>
                        Trocar conta
                    </button>
                    <button class="rc-icon-btn" id="settingsMediaButton" data-tip="Oficina (configurações)" aria-label="Configurações">
                        <svg viewBox="0 0 24 24"><path d="M19.4 13a7.6 7.6 0 000-2l2-1.6-2-3.4-2.4 1a7.3 7.3 0 00-1.7-1l-.4-2.5h-4l-.4 2.5a7.3 7.3 0 00-1.7 1l-2.4-1-2 3.4L4.6 11a7.6 7.6 0 000 2l-2 1.6 2 3.4 2.4-1a7.3 7.3 0 001.7 1l.4 2.5h4l.4-2.5a7.3 7.3 0 001.7-1l2.4 1 2-3.4-2-1.6zM12 15.5A3.5 3.5 0 1112 8.5a3.5 3.5 0 010 7z"/></svg>
                    </button>
                </div>
            </div>
        </aside>

        <!-- ══════════ GAZETA DE SELENIA ══════════ -->
        <section id="rcGazeta" class="rc-card">
            <header class="rc-gazeta-head">
                <div class="rc-masthead">
                    <span class="rc-masthead-title">A Gazeta de Selenia</span>
                    <span id="rcEdition" class="rc-masthead-edition">&nbsp;</span>
                </div>
                <nav class="rc-tabs" aria-label="Seções da Gazeta">
                    <button class="rc-tab news-tab active" data-tab="news">Gazeta</button>
                    <button class="rc-tab news-tab" data-tab="journal">Crônicas</button>
                    <button class="rc-tab news-tab" data-tab="events">Eventos</button>
                    <button class="rc-tab news-tab" data-tab="tickets">Tickets <span id="rcTicketsBadge" class="rc-badge" style="display:none;"></span></button>
                </nav>
            </header>
            <div class="rc-gazeta-body">
                <div id="rcNewsList" class="news-list rc-paper" data-content="news">
                    <div class="rc-news-placeholder"><span class="rc-spinner"></span>Rodando a prensa…</div>
                </div>
                <div id="rcJournalList" class="news-list rc-paper" data-content="journal" style="display:none;">
                    <div class="rc-news-placeholder"><span class="rc-spinner"></span>Abrindo as crônicas…</div>
                </div>
                <div id="rcEventsList" class="news-list" data-content="events" style="display:none;">
                    <div class="rc-news-placeholder"><span class="rc-spinner"></span>Consultando o calendário…</div>
                </div>
                <div id="rcTicketsList" class="news-list" data-content="tickets" style="display:none;">
                    <div class="rc-news-placeholder"><span class="rc-spinner"></span>Carregando tickets…</div>
                </div>
            </div>
        </section>

        <!-- ══════════ TORRE DE VIGIA ══════════ -->
        <aside id="rcTorre">
            <section class="rc-card rc-hud rc-status">
                <div class="rc-hud-corners"></div>
                <div class="rc-status-head">
                    <span class="rc-eyebrow">Torre de vigia</span>
                    <button id="server_selection_button" class="rc-link rc-status-server"><%- lang('landing.launchButtonPlaceholder') %></button>
                </div>
                <div class="rc-server-status">
                    <span class="status-dot offline"></span>
                    <span id="landingPlayerLabel"><%- lang('landing.serverStatus') %></span>
                </div>
                <div class="rc-status-players"><span id="player_count"><%- lang('landing.serverStatusPlaceholder') %></span></div>
                <div class="rc-status-rows">
                    <div class="rc-status-row">
                        <span>Ping</span>
                        <span class="rc-ping"><b id="rcPing">—</b><span class="rc-ping-bars" id="rcPingBars" data-level="0"><i></i><i></i><i></i><i></i></span></span>
                    </div>
                    <button id="rcCopyIp" class="rc-ip" data-tip="Copiar endereço">
                        <span id="rcIp">—</span>
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M16 1H4a2 2 0 0 0-2 2v14h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H8V7h11v14z"/></svg>
                    </button>
                </div>
            </section>

            <section class="rc-card rc-events-mini">
                <div class="rc-section-title"><span class="rc-eyebrow">Próximos eventos</span></div>
                <div id="rcEventsMini"><div class="rc-events-empty">Nenhum evento marcado.</div></div>
            </section>

            <% const discordURL_ = lang('landing.mediaDiscordURL') %>
            <nav class="rc-hotbar" aria-label="Atalhos">
                <button class="rc-slot" data-key="1" data-url="<%= lang('landing.shortcutStoreURL') %>" data-tip="Loja">
                    <svg viewBox="0 0 24 24"><path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM5.2 4H2V2h4.5l.9 2H21l-3.4 8.1a2 2 0 0 1-1.8 1.2H8.1l-1 1.7H19v2H5.5l2.3-4L5.2 4z"/></svg>
                    <span>Loja</span>
                </button>
                <button class="rc-slot" data-key="2" data-url="<%= lang('landing.shortcutRulesURL') %>" data-tip="Regras">
                    <svg viewBox="0 0 24 24"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm8 1.5V8h4.5L14 3.5zM7 12v2h10v-2H7zm0 4v2h7v-2H7z"/></svg>
                    <span>Regras</span>
                </button>
                <button class="rc-slot" data-key="3" data-url="<%= discordURL_ %>" data-tip="Discord">
                    <svg viewBox="0 0 24 24"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.4 18.4 0 0 0-5.6 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2a12.8 12.8 0 0 1-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2a19.9 19.9 0 0 0 6-3c.5-5.2-.9-9.7-3.6-13.7zM8 15.3c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4z"/></svg>
                    <span>Discord</span>
                </button>
                <button class="rc-slot" data-key="4" data-url="<%= lang('landing.shortcutSiteURL') %>" data-tip="Site oficial">
                    <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-3a15.6 15.6 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8zM12 4c.8 1.2 1.5 2.5 1.9 4h-3.8c.4-1.5 1.1-2.8 1.9-4zM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3zm.8 2h3a15.6 15.6 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16zm3-8h-3a8 8 0 0 1 4.4-3.6C8.9 5.5 8.4 6.7 8.1 8zM12 20c-.8-1.2-1.5-2.5-1.9-4h3.8c-.4 1.5-1.1 2.8-1.9 4zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4zm.3 5.6c.6-1.1 1.1-2.3 1.4-3.6h3a8 8 0 0 1-4.4 3.6zm1.7-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4z"/></svg>
                    <span>Site</span>
                </button>
                <button class="rc-slot" data-key="5" data-action="tickets" data-tip="Abrir ticket">
                    <svg viewBox="0 0 24 24"><path d="M22 10V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v4a2 2 0 1 1 0 4v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 1 1 0-4zm-9 7.5h-2v-2h2v2zm0-4.5h-2v-2h2v2zm0-4.5h-2v-2h2v2z"/></svg>
                    <span>Ticket</span>
                </button>
            </nav>

            <div id="rcVersion" class="rc-ver">v1.0.8</div>
        </aside>
    </div>

    <!-- ══════════ BARRA DE XP (progresso do launch) ══════════ -->
    <div id="launch_details" class="rc-xp" style="display: none;">
        <div class="rc-xp-meta">
            <span id="launch_details_text" class="rc-xp-text"><%- lang('landing.launchDetails') %></span>
            <span id="launch_progress_label" class="rc-xp-percent">0%</span>
        </div>
        <div id="launch_progress" class="rc-xp-bar"><div id="launch_progress_fill"></div></div>
    </div>

    <!-- Nome do usuário (fonte de verdade do landing.js; espelhado em #user_text_main) -->
    <span id="user_text" style="display:none;"><%- lang('landing.usernamePlaceholder') %></span>

    <script src="./assets/js/scripts/landing.js"></script>
</div>
